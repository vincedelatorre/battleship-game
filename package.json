{
  "name": "battleship-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pirate-themed Battleship vs an AI — TypeScript + Vite + three.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
